<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" alignment="CENTER" xmlns:fx="http://javafx.com/fxml" fx:controller="gui.QTController" style="-fx-padding: 20;">
    <Label text="Configurazione Mining" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    
    <HBox spacing="10" alignment="CENTER">
        <Label text="Tabella DB:"/>
        <TextField fx:id="tableNameField" />
    </HBox>
    
    <HBox spacing="10" alignment="CENTER">
        <Label text="Raggio (Radius):"/>
        <TextField fx:id="radiusField" />
    </HBox>
    
    <Separator/>
    
    <HBox spacing="10" alignment="CENTER">
        <Button text="Esegui Mining" onAction="#handleMining" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
        <Button text="Salva Risultati" onAction="#handleSave"/>
        <Button text="Carica da File" onAction="#handleLoad"/>
    </HBox>
    
    <Label text="Risultati:"/>
    <TextArea fx:id="outputArea" VBox.vgrow="ALWAYS" editable="false" style="-fx-font-family: 'Courier New';"/>
</VBox>